{
  "name": "dsh-media-studio",
  "version": "0.3.0",
  "description": "DSH plugin: infinite-canvas editor with media node refresh. Sibling plugin dsh-llm-multimodal owns the LLM-facing config + tools.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsdown && bash scripts/setup-preset.sh",
    "typecheck:client": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --jsx react-jsx --lib ES2022,DOM,DOM.Iterable --strict --skipLibCheck src/client/canvas.tsx src/client/nodes.tsx src/client/canvas-api.ts src/client/icons.tsx src/client/lightbox.tsx src/client/canvas-styles.ts src/client/project-bar.tsx src/client/projects-api.ts src/client/i18n.ts src/client/assets-api.ts src/client/asset-panel.tsx src/client/http-shared.ts src/client/use-i18n-hook.ts src/client/global-search.tsx src/client/search-api.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
    "@xyflow/react": "^12.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "betterSidebar"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "Apache-2.0"
}
